NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/securepay
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=8h
ML_SERVICE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@securepay.dev
SEED_ADMIN_PASSWORD=Admin@SecurePay2024
SEED_ANALYST_EMAIL=analyst@securepay.dev
SEED_ANALYST_PASSWORD=Analyst@SecurePay2024
# Webhook Security (strictly minimum 32 characters)
WEBHOOK_SECRET=replace-with-a-random-secret
DEV_WEBHOOK_SECRET=replace-with-a-different-random-secret
# ML Policy: 'optional' (hybrid fallback), 'rules_only', or 'mandatory' (holds for review on failure)
ML_AVAILABILITY_POLICY=optional
WEBHOOK_STALE_TIMEOUT_MS=300000
